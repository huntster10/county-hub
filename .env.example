# ──────────────────────────────────────────────────────────────────────────────
#  County Hub — environment variables
#  1. Copy this file and name the copy  .env.local
#  2. Fill in the values (instructions in README.md)
#  3. Restart `npm run dev` after any change
#  Never commit .env.local or share it — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key (older projects) or "publishable" key (newer projects). Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (older) or "secret" key (newer). SERVER ONLY — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Your website address ──────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# After deploying, change to your real address, e.g. https://hub.yourcommunity.com

# ── Roblox OAuth 2.0 (for real logins) ────────────────────────────────────────
# Register an app at https://create.roblox.com/dashboard/credentials  (OAuth 2.0 apps)
# Redirect URL must be exactly:  <NEXT_PUBLIC_APP_URL>/api/auth/roblox/callback
# Scopes: openid, profile
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# ── Developer login (local testing only) ──────────────────────────────────────
# true  → shows a "sign in as test user" form on the login page (no Roblox needed)
# false → Roblox login only. Set to false before inviting your community!
DEV_LOGIN_ENABLED=true

# ── ER:LC Private Server API (optional) ───────────────────────────────────────
# You can also paste the key in the app under Settings, which takes priority.
# In-game: Server Settings → ER:LC API → copy key (requires the API server pack)
ERLC_API_KEY=
